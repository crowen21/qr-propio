# Configuración de QR Propio. En el servidor vive en /etc/qr-propio.env
# Después de cambiar algo:  sudo systemctl restart qr-propio

# Dirección pública. Los QR llevan esta dirección adentro: déjala en el dominio definitivo ANTES de imprimir.
QR_BASE_URL=http://localhost:8000
QR_SITE_NAME=QR Propio
QR_DATA_DIR=/var/lib/qr-propio
QR_SECRET_KEY=cambiar
QR_FREE_QRS=1
QR_PRO_QRS=100

# Correo para confirmar cuentas (por ejemplo Amazon SES por SMTP).
# Mientras QR_SMTP_HOST esté vacío, los enlaces de confirmación solo aparecen en: journalctl -u qr-propio
# Opción A (recomendada en EC2): Amazon SES con el rol de la instancia, sin claves.
QR_SES_REGION=
# Opción B: cualquier servidor SMTP.
QR_SMTP_HOST=
QR_SMTP_PORT=587
QR_SMTP_USER=
QR_SMTP_PASS=
QR_SMTP_FROM=

# Ingreso con Google y Microsoft (cada botón aparece solo si están su ID y su secreto).
# Dirección de retorno que hay que registrar en cada proveedor:
#   https://TU-DOMINIO/entrar/google/retorno      https://TU-DOMINIO/entrar/microsoft/retorno
QR_GOOGLE_CLIENT_ID=
QR_GOOGLE_CLIENT_SECRET=
QR_MS_CLIENT_ID=
QR_MS_CLIENT_SECRET=

# Pagos con Flow (https://www.flow.cl). Primero con el sandbox; luego cambiar a https://www.flow.cl/api
QR_FLOW_API_URL=https://sandbox.flow.cl/api
QR_FLOW_API_KEY=
QR_FLOW_SECRET=

# Correo que recibe alertas del sistema.
QR_ADMIN_EMAIL=
# Correos (separados por coma) que pueden ver /admin
QR_ADMINS=

# Opcional: clave de Google Safe Browsing (gratis, pero solo para uso NO comercial).
QR_SAFE_BROWSING_KEY=

# Opcional: bucket S3 para el respaldo diario (requiere AWS CLI y un rol IAM con permiso de escritura).
QR_BACKUP_BUCKET=
